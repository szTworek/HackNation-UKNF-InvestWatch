# Skopiuj do .env i uzupełnij. Wartości poniżej to domyślne ustawienia deweloperskie z compose.yaml (bez sekretów).

# Postgres (dane aplikacji) i MinIO (grafiki, zrzuty stron). Zmień hasła poza komputerem deweloperskim.
POSTGRES_DB=investwatch
POSTGRES_USER=investwatch
POSTGRES_PASSWORD=investwatch
MINIO_ROOT_USER=investwatch
MINIO_ROOT_PASSWORD=investwatch-dev
MINIO_CONSOLE_PORT=9001

# Ocena LLM: none (słownik bazowy) | groq (wymaga GROQ_API_KEY) | ollama (--profile local-llm)
LLM_BACKEND=none
GROQ_API_KEY=
# Loader z LLM: ile rekordów ocenić w jednym przebiegu (reszta czeka na: docker compose run --rm loader)
LOADER_LLM_LIMIT=100
LOADER_LLM_BATCH=8

# Kolektor YouTube
YOUTUBE_API_KEY=
# Tryb filmowy zbierania: 1 = transkrypcja filmów YouTube/TikTok (przy pierwszym użyciu pobiera model Whispera, ok. 500 MB do volume collector-cache)
SCRAPE_VIDEOS=0
# Filmów na zapytanie YouTube i na konto TikTok w trybie filmowym
VIDEOS_MAX_PER_QUERY=3
