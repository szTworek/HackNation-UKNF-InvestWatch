# Frontend (wczytywane przez Vite przy buildzie)
VITE_API_URL=http://localhost:4000/api
VITE_WS_URL=http://localhost:4000

# Mock serwer
MOCK_PORT=4000
# Odstęp między nowymi rekordami z socketu (ms). Na demo: 3000 / 6000 albo `npm run dev:demo`.
MOCK_EMIT_MIN_MS=15000
MOCK_EMIT_MAX_MS=30000
MOCK_SEED=42
# Dozwolony origin dla CORS (* = dowolny)
MOCK_CORS_ORIGIN=*
