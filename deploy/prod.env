# Środowisko prod (wdrażane z tagu vX.Y.Z). Bez sekretów.
# FRONTEND_BIND=127.0.0.1 zakłada reverse proxy z TLS na hoście. 0.0.0.0 wystawia port publicznie po HTTP.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080
AI_PORT=8000
USE_GPU=0
INVESTWATCH_BASELINE=0
MOCK_EMIT_MIN_MS=15000
MOCK_EMIT_MAX_MS=30000
# Front i API są same-origin przez nginx, więc CORS nie jest potrzebny.
MOCK_CORS_ORIGIN=http://localhost:8080
